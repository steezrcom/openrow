DATABASE_URL=postgres://openrow:openrow@localhost:5432/openrow?sslmode=disable

# AES-256-GCM root key. Generate once with: `openssl rand -base64 32`.
# Single-key mode: set OPENROW_SECRET_KEY only. Treated as version 1; all
# new writes use the versioned ciphertext format, old rows decrypt via
# the legacy path.
OPENROW_SECRET_KEY=

# Versioned (rotation-friendly) mode: set one or more
# OPENROW_SECRET_KEY_V<n> values. The highest version writes new
# ciphertext by default; override with OPENROW_WRITE_KEY_VERSION. Keep
# the previous key around so old rows still decrypt until they're
# rewritten by the application (lazy re-encryption is on the roadmap).
# OPENROW_SECRET_KEY_V1=...
# OPENROW_SECRET_KEY_V2=...
# OPENROW_WRITE_KEY_VERSION=2

# Optional: fallback LLM when a workspace has no per-tenant config.
# Used for dev convenience. Each workspace can override via Settings → LLM.
ANTHROPIC_API_KEY=

# Default seed password for `make seed` / `make seed-reset`. Local dev only.
OPENROW_SEED_PASSWORD=openrow123

HTTP_ADDR=:8080
APP_URL=http://localhost:5173
# Defaults to true (secure cookies + HSTS). Set INSECURE_COOKIES_FOR_DEV=true
# to relax for plain-HTTP development.
# INSECURE_COOKIES_FOR_DEV=true
LOG_LEVEL=info

# --- SMTP (password reset, magic links) ---------------------------------
# Leave SMTP_HOST empty in dev to log emails to stdout. In production
# without SMTP_HOST set, the server uses a Noop mailer that records
# recipient + subject but never the body, so reset URLs don't land in
# log aggregators.
# SMTP_HOST=smtp.eu.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=openrow <noreply@openrow.app>
# SMTP_TLS_IMPLICIT=false   # true for implicit TLS on port 465
